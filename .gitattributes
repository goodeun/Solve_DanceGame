# Auto detect text files and perform LF normalization
* text=auto

Assets/Plugins/FMOD/**/*.bundle text eol=lf
Assets/Plugins/FMOD/**/Info.plist text eol=lf

# ==========================================
# FMOD Studio Metadata (Merge & EOL)
# ==========================================
# XML 메타데이터 줄바꿈 통일 (Windows/Mac 협업 필수)
*.xml text eol=lf
*.fspro text eol=lf

# ==========================================
# Audio Assets & FMOD Banks (Git LFS 권장)
# ==========================================
# 원본 에셋 (FMOD 프로젝트 내 Assets 폴더)
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text

# 뱅크 파일도 Git으로 형상 관리할 경우 (StreamingAssets 유지 시)
*.bank filter=lfs diff=lfs merge=lfs -text
*.strings.bank filter=lfs diff=lfs merge=lfs -text